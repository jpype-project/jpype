<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jpype.bench</groupId>
  <artifactId>graalpy-benchmark</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Pinned to 25.0.2, not the latest 25.2.4, for two reasons that both
         land on this exact patch version:
         1. It's on the 25.0.x line, which has a prebuilt
            "graalpy250"-tagged numpy wheel at
            https://www.graalvm.org/python/wheels/numpy/. Anything newer
            (e.g. 25.2.4) forces pip to fall back to compiling numpy from
            source via meson, which OOM-killed this 7.7GB machine (nested
            JVMs: Maven, pip, meson, each its own ~1GB+ Truffle runtime,
            plus meson's parallel gcc workers on top).
         2. 25.0.3/25.0.4 have no matching standalone GraalVM CE JDK
            release (graalvm-ce-builds skips straight to the 25.1.x
            "Innovation" compiler line for those JDK patch versions), and
            running Truffle 25.0.4 jars on a 25.1.3-compiler JDK throws
            UnsatisfiedLinkError (LibGraalScope.attachThreadTo) at
            startup, a libgraal ABI mismatch. 25.0.2 has a same-version
            GraalVM CE JDK (~/.local/graalvm-community-openjdk-25.0.2+10.1)
            so the bundled libgraal and these Maven jars actually agree,
            which is required to get real JIT tier-4 compilation instead
            of "fallback runtime, interpreter only". -->
    <graalpy.version>25.0.2</graalpy.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>polyglot</artifactId>
      <version>${graalpy.version}</version>
    </dependency>
    <dependency>
      <groupId>org.graalvm.python</groupId>
      <artifactId>python-embedding</artifactId>
      <version>${graalpy.version}</version>
    </dependency>
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>python</artifactId>
      <version>${graalpy.version}</version>
      <type>pom</type>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.graalvm.python</groupId>
        <artifactId>graalpy-maven-plugin</artifactId>
        <version>${graalpy.version}</version>
        <executions>
          <execution>
            <configuration>
              <packages>
                <package>numpy==2.2.4</package>
                <!-- pinned: latest version with a prebuilt "graalpy250" wheel -->

              </packages>
            </configuration>
            <goals>
              <goal>process-graalpy-resources</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>copy-deps</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
